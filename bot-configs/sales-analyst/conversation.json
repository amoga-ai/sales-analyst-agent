{
  "startNode": "ask_name",
  "nodes": {
    "ask_name": {
      "type": "question",
      "message": "What is your name?",
      "input": {
        "type": "text",
        "variable": "user_name",
        "required": true,
        "minLength": 2,
        "maxLength": 80
      },
      "next": "select_review"
    },
    "select_review": {
      "type": "choice",
      "message": "Hello {{user_name}}. What would you like to review?",
      "options": [
        {
          "label": "Sales Review",
          "value": "sales_review",
          "actionId": "select_sales_review",
          "next": "ask_period"
        }
      ]
    },
    "ask_period": {
      "type": "choice",
      "message": "Which period would you like to review?",
      "variable": "review_period",
      "options": [
        { "label": "This Month", "value": "this_month", "next": "confirm_review" },
        { "label": "Last Month", "value": "last_month", "next": "confirm_review" },
        { "label": "This Year", "value": "this_year", "next": "confirm_review" }
      ]
    },
    "confirm_review": {
      "type": "approval",
      "message": "Run the sales review for {{review_period_label}}?",
      "options": [
        {
          "label": "Approve",
          "value": "approve",
          "actionId": "approve_review",
          "next": "run_review"
        },
        {
          "label": "Cancel",
          "value": "cancel",
          "actionId": "cancel_review",
          "next": "cancelled"
        }
      ]
    },
    "run_review": {
      "type": "api",
      "action": "sales_summary",
      "next": "done"
    },
    "cancelled": {
      "type": "message",
      "message": "Review cancelled."
    },
    "done": {
      "type": "message",
      "message": "Review complete."
    }
  }
}